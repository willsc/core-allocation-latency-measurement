BEGIN { @origin_ns = nsecs(monotonic); printf("METALBENCH_BPF_READY %llu\n", @origin_ns); }
tracepoint:sched:sched_wakeup /(args->target_cpu == 1) && args->pid > 0/ { if (!@wake[args->pid]) { @wake[args->pid] = nsecs(monotonic); } }
tracepoint:sched:sched_switch { $begin = @wake[args->next_pid]; if ($begin) { if ((cpu == 1)) { $delta = nsecs(monotonic) - $begin; $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @runq_count[cpu, $bucket] = count(); @runq_ns[cpu, $bucket] = sum($delta); @runq_max[cpu, $bucket] = max($delta); } else { @overflow = count(); } } delete(@wake[args->next_pid]); } }
tracepoint:tlb:tlb_flush /(cpu == 1)/ { $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @tlb_count[cpu, $bucket] = count(); } else { @overflow = count(); } }
tracepoint:irq:irq_handler_entry /(cpu == 1)/ { @irq_start[cpu, args->irq] = nsecs(monotonic); $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @irq_count[cpu, $bucket] = count(); } else { @overflow = count(); } }
tracepoint:irq:irq_handler_exit /(cpu == 1)/ { $begin = @irq_start[cpu, args->irq]; if ($begin) { $delta = nsecs(monotonic) - $begin; $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @irq_ns[cpu, $bucket] = sum($delta); } else { @overflow = count(); } delete(@irq_start[cpu, args->irq]); } }
tracepoint:irq:softirq_entry /(cpu == 1)/ { @softirq_start[cpu, args->vec] = nsecs(monotonic); $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @softirq_count[cpu, $bucket] = count(); } else { @overflow = count(); } }
tracepoint:irq:softirq_exit /(cpu == 1)/ { $begin = @softirq_start[cpu, args->vec]; if ($begin) { $delta = nsecs(monotonic) - $begin; $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @softirq_ns[cpu, $bucket] = sum($delta); } else { @overflow = count(); } delete(@softirq_start[cpu, args->vec]); } }
tracepoint:power:cpu_idle /(cpu == 1)/ { if (args->state != 4294967295) { @idle_start[cpu] = nsecs(monotonic); $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @idle_count[cpu, $bucket] = count(); } else { @overflow = count(); } } else { $begin = @idle_start[cpu]; if ($begin) { $delta = nsecs(monotonic) - $begin; $bucket = (nsecs(monotonic) - @origin_ns) / 100000000; if ($bucket < 512) { @idle_ns[cpu, $bucket] = sum($delta); } else { @overflow = count(); } delete(@idle_start[cpu]); } } }
END { printf("METALBENCH_BPF_END %llu\n", nsecs(monotonic)); clear(@wake); clear(@irq_start); clear(@softirq_start); clear(@idle_start); }
